# 复制为 .env（本地会自动加载）；Docker/服务端可直接注入环境变量。
# DOCUMENTX_* 会覆盖 config.toml 的每一个字段。以下均为示例，请按需取消注释。

# [server]
# DOCUMENTX_SERVER_HOST=0.0.0.0
# DOCUMENTX_SERVER_PORT=8080
# DOCUMENTX_SERVER_BASE_PATH=/documentx
# DOCUMENTX_SERVER_MAX_BODY_MB=16

# [ui]（快捷提问使用 JSON 字符串数组）
# DOCUMENTX_UI_BRAND_TITLE=DocumentX
# DOCUMENTX_UI_BRAND_SUBTITLE=文档智能体 · 小文
# DOCUMENTX_UI_WELCOME_TITLE=嗨，我是小文 👋
# DOCUMENTX_UI_WELCOME_DESCRIPTION=DocumentX 的文档助手。我会基于你的知识库回答，也能按模板生成文档。
# DOCUMENTX_UI_SUGGESTIONS=["总结知识库核心内容","列出所有 API","解释鉴权流程"]

# [llm]
DOCUMENTX_LLM_BASE_URL=https://api.openai.com/v1
DOCUMENTX_LLM_API_KEY=sk-xxxx
DOCUMENTX_LLM_MODEL=gpt-4o-mini
# DOCUMENTX_LLM_GENERATE_MODEL=gpt-4o
# DOCUMENTX_LLM_TEMPERATURE=0.3
# DOCUMENTX_LLM_READ_TIMEOUT_SECS=120
# DOCUMENTX_LLM_REQUEST_TIMEOUT_SECS=240
# DOCUMENTX_LLM_MAX_RETRIES=4
# DOCUMENTX_LLM_STREAM_IDLE_TIMEOUT_SECS=120
# DOCUMENTX_LLM_CONTEXT_WINDOW_TOKENS=128000
# DOCUMENTX_LLM_MAX_RESPONSE_TOKENS=4096
# DOCUMENTX_LLM_ENABLE_COMPACTION=true

# [paths]（knowledge/templates/agents 只在 local 模式使用；static 始终使用）
# DOCUMENTX_PATHS_KNOWLEDGE_DIR=/data/documentx/knowledge
# DOCUMENTX_PATHS_TEMPLATES_DIR=/data/documentx/templates
# DOCUMENTX_PATHS_STATIC_DIR=/app/web
# DOCUMENTX_PATHS_AGENTS_FILE=/data/documentx/AGENTS.md

# [diagrams]
# DOCUMENTX_DIAGRAMS_ENABLED=true
# DOCUMENTX_DIAGRAMS_MAX_SOURCE_KB=256
# DOCUMENTX_DIAGRAMS_MAX_PER_DOCUMENT=32
# DOCUMENTX_DIAGRAMS_MAX_SVG_KB=1024
# DOCUMENTX_DIAGRAMS_MAX_PNG_KB=8192

# [content]
# DOCUMENTX_CONTENT_MODE=s3
# DOCUMENTX_CONTENT_REFRESH_INTERVAL_SECS=300
# DOCUMENTX_CONTENT_MAX_FILE_KB=2048
# DOCUMENTX_CONTENT_MAX_FILES=10000

# [content.s3]
# DOCUMENTX_CONTENT_S3_ENDPOINT=https://s3.example.com
# DOCUMENTX_CONTENT_S3_REGION=us-east-1
# DOCUMENTX_CONTENT_S3_BUCKET=documentx-content
# DOCUMENTX_CONTENT_S3_ROOT_PREFIX=documentx
# DOCUMENTX_CONTENT_S3_FORCE_PATH_STYLE=true
# DOCUMENTX_CONTENT_S3_ALLOW_HTTP=false
# DOCUMENTX_CONTENT_S3_DOWNLOAD_CONCURRENCY=8

# S3 凭据不写进 TOML。可用以下 DocumentX 别名：
# DOCUMENTX_CONTENT_S3_ACCESS_KEY_ID=example-access-key
# DOCUMENTX_CONTENT_S3_SECRET_ACCESS_KEY=example-secret-key
# DOCUMENTX_CONTENT_S3_SESSION_TOKEN=example-session-token
# 也支持标准 AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN，
# 以及 SDK 默认凭据链。不要把真实凭据提交进仓库。

# 兼容旧部署：LLM_BASE_URL、LLM_API_KEY、LLM_MODEL、LLM_GENERATE_MODEL、PORT、
# DIAGRAMS_ENABLED 仍有效，但同一字段的 DOCUMENTX_* 优先级更高。
